# LARO environment template. Copy to .env and set only the values you need.
# Never commit a real .env file.

# Electron/tRPC runtime. The packaged desktop app generates JWT_SECRET and
# COOKIE_SECRET in <userData>/laro-secrets.json.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# API-only deployments disable renderer file serving. The ngrok launcher sets
# this through Docker Compose and keeps the container bound to host loopback.
SERVER_ONLY=false
# Runtime mode defaults to `local`, preserving the existing Electron/SQLite
# behavior. `hosted` is for the public service and requires every hosted value
# below; production startup fails closed when one is missing.
LARO_RUNTIME_MODE=local
# API-only deployments require this one-time token for their first account.
# Use 32-256 random characters. Enrollment closes after that owner exists.
STANDALONE_SIGNUP_TOKEN=
# Stable Docker Compose identity for API deployments. Keep this value unchanged
# across checkout-folder moves so the same named data volume is reused.
LARO_COMPOSE_PROJECT_NAME=laro
# Explicit browser origins allowed to call the credentialed API. Never use *.
ALLOWED_ORIGINS=
# Optional public gateway prefix for shared-domain API deployments.
PUBLIC_PATH_PREFIX=
# Public base used for connector instructions and HAI source configuration.
# The ngrok launcher sets this automatically to the verified /laro route.
LARO_PUBLIC_BASE_URL=
LARO_PUBLIC_ORIGIN=
LARO_PUBLIC_PATH_PREFIX=
# The verified ngrok launcher persists these non-secret contract markers. When
# enabled, startup fails if the public route or accepted providers are missing.
LARO_PUBLIC_DEPLOYMENT_REQUIRED=false
LARO_REQUIRED_LIVE_PROVIDERS=
# Optional Vite development proxy target when the API uses a non-default port.
VITE_LARO_API_URL=http://127.0.0.1:3000
API_BODY_LIMIT=10mb
JWT_SECRET=
COOKIE_SECRET=

# Electron/tRPC database and evidence storage.
DATABASE_URL=
LOCAL_STORAGE_DIR=
# Maintenance CLI only: optional explicit path to the packaged desktop key file.
# When omitted, db:backup discovers laro-secrets.json beside DATABASE_URL.
LARO_DESKTOP_SECRETS_PATH=
# Maintenance CLI only: optional explicit local evidence root for backup/restore.
LARO_LOCAL_STORAGE_PATH=
# Automatic recovery-ready backup sets. In Docker, HOST_DIRECTORY is mounted at
# /backups. Point it at a OneDrive/network location and set the matching kind
# for an off-device copy; `local` never claims off-device protection.
LARO_BACKUP_HOST_DIRECTORY=./.laro-backups
LARO_BACKUP_DESTINATION_KIND=local
LARO_BACKUP_RETENTION_COUNT=14
LARO_BACKUP_RETENTION_DAYS=30
LARO_BACKUP_MAX_AGE_HOURS=30
# Audit history is purged automatically after this many days. Accepted range:
# 30-3650. Invalid values stop startup instead of risking an unsafe purge.
AUDIT_RETENTION_DAYS=365
# Standalone server only: path-delimited roots the server may scan for local evidence.
# The packaged desktop uses its native folder picker instead.
LOCAL_SCAN_ROOTS=
AWS_S3_BUCKET=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=eu-west-1
# Hosted public service only. Use a PostgreSQL URL, a shared Redis service, and
# a 64-character random hexadecimal encryption key. Never use these values in
# a portable Electron distribution or commit them to Git.
REDIS_URL=
LARO_HOSTED_ENCRYPTION_KEY=
# Local hosted PostgreSQL integration testing only. `docker-compose.hosted.yml`
# uses the corresponding LARO_HOSTED_POSTGRES_* variables and binds PostgreSQL
# to loopback. Do not set a development password in public production.
LARO_HOSTED_POSTGRES_DB=laro
LARO_HOSTED_POSTGRES_USER=laro
LARO_HOSTED_POSTGRES_PASSWORD=
LARO_HOSTED_POSTGRES_PORT=54329
LARO_HOSTED_TEST_DATABASE_URL=

# Optional AI providers for the Electron/tRPC runtime. The owner selects exactly
# one provider in Settings; local analysis is the default and needs no API key.
FORGE_API_URL=
FORGE_API_KEY=
LARO_FORGE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LARO_OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
LARO_ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_GEMINI_API_KEY=
LARO_GOOGLE_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
LARO_DEEPSEEK_MODEL=deepseek-v4-flash
GROQ_API_KEY=
LARO_GROQ_MODEL=openai/gpt-oss-120b
TOGETHER_API_KEY=
LARO_TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Optional connectors for the Electron/tRPC runtime. On the Windows ngrok API,
# prefer scripts/configure-live-providers.ps1 for Google and SMTP secrets.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
# Optional ngrok deployment settings used by the launcher. Mode is `gateway`
# for a stable shared-domain path or `direct` for an assigned public tunnel.
LARO_NGROK_MODE=gateway
LARO_NGROK_GATEWAY_URL=
LARO_NGROK_PATH_PREFIX=/laro
LARO_NGROK_INTERNAL_URL=https://laro.internal
TRELLO_API_KEY=
TELEGRAM_BOT_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Flask command-center runtime. run_local.ps1 uses this dedicated port so both
# runtimes can be configured from the same .env without a PORT collision.
LARO_FLASK_PORT=8768

# The Flask session signing key. Generate a long, random local value.
SECRET_KEY=
LARO_HOST=127.0.0.1
LARO_DEBUG=false
LARO_AUTH_DATABASE_PATH=instance/laro_auth.sqlite3
# Optional password reset delivery. The URL template must contain {token}.
# SMTP_HOST/PORT/USER/PASS/FROM above are reused by the Flask runtime.
LARO_PASSWORD_RESET_URL_TEMPLATE=http://127.0.0.1:8768/reset-password.html?token={token}
SMTP_STARTTLS=true

# Persistent local-first ledger. This path stays ignored by Git.
LARO_LEDGER_DATABASE_URL=sqlite:///instance/laro_ledger.sqlite3
LARO_UPLOAD_ROOT=instance/uploads
LARO_MAX_UPLOAD_BYTES=26214400
# Maximum total uncompressed size of an approved case-bundle ZIP.
LARO_BUNDLE_MAX_BYTES=104857600
LARO_TOKEN_STORE_DIR=tokens
# Flask recovery commands load this file, bind external secrets by a
# non-reversible compatibility tag, and never copy the .env into a backup set.
# The only account allowed to use the localhost-only session bootstrap used by
# the local command dashboards. Use password login for any additional account.
LARO_LOCAL_ACCOUNT_EMAIL=robert.local@laro
# Optional: provide a Fernet key instead of using the local ignored vault key file.
LARO_TOKEN_ENCRYPTION_KEY=

# Optional local-only deep document reading. LARO only accepts a loopback Ollama
# endpoint, reads long sources in bounded batches, and discards model observations
# that do not cite literal source text. MAX_CHARS is per model batch, not per case.
LARO_ANALYSIS_PROVIDER=rule_based
LARO_OLLAMA_BASE_URL=http://127.0.0.1:11434
LARO_OLLAMA_MODEL=
LARO_OLLAMA_TIMEOUT_SECONDS=45
LARO_LOCAL_ANALYSIS_MAX_CHARS=20000

# Optional Google Gmail/Drive read-only OAuth connection shared by both runtimes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8768/api/google/oauth/callback
